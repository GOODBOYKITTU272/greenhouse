# Required — brain_worker.py and muscle_worker.py both fail to start without these.
# Set real values only in Railway's environment variables. Never commit real values here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_rotated_service_role_key"

# Required — muscle_worker.py's DataImpulse residential proxy. Either set PROXY_CONFIG as a
# single JSON blob {"server":...,"username":...,"password":...}, or set these three instead.
PROXY_SERVER="http://gw.dataimpulse.com:823"
PROXY_USERNAME="your_rotated_proxy_username"
PROXY_PASSWORD="your_rotated_proxy_password"

# Required for the AI answer layer (applywizz_brain.py). Currently defaults to an empty
# string if unset, which starts the worker but makes every AI-routed answer fail silently —
# worth hardening to fail loudly too, same as the vars above.
OPENROUTER_API_KEY="your_openrouter_api_key"

# Optional — defaults to https://zoho-mail-reader.onrender.com if unset.
ZOHO_BASE_URL="https://zoho-mail-reader.onrender.com"

# Optional — only used by the dashboard, and only the anon key (never the service role key)
# should ever be used client-side. Requires RLS to actually be enabled on the tables it reads.
SUPABASE_ANON_KEY="your_rotated_anon_key"
